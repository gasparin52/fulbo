rules_version = '2';

// Reglas de seguridad de Firestore. Pegarlas en la consola de Firebase:
// Firestore Database → Reglas → Publicar.
// El dominio "fulbo.app" tiene que coincidir con CONFIG.dominio de index.html.
service cloud.firestore {
  match /databases/{database}/documents {
    function logueado() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function grupo(g) { return get(/databases/$(database)/documents/grupos/$(g)).data; }
    function esMiembro(g) {
      return logueado() && exists(/databases/$(database)/documents/grupos/$(g)/miembros/$(uid()));
    }
    function esAdmin(g) { return logueado() && uid() in grupo(g).admins; }
    // Armadores: designados por un admin para armar y editar equipos.
    function esArmador(g) { return logueado() && uid() in grupo(g).get('armadores', []); }
    function cambia() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Solo toca su propio pedido de cambio de equipo.
    function soloMiSolicitud() {
      let nuevas = request.resource.data.get('solicitudes', {});
      return nuevas.diff(resource.data.get('solicitudes', {})).affectedKeys().hasOnly([uid()])
        && (!(uid() in nuevas) || (nuevas[uid()].keys().hasOnly(['a', 'ts']) && nuevas[uid()].a in ['A', 'B']));
    }

    // Ficha de un jugador: el nombre tiene que ser el de su propia cuenta.
    function perfilValido(d) {
      return d.usuario is string
        && d.usuario.lower() + '@fulbo.app' == request.auth.token.email
        && d.edad is int && d.edad >= 10 && d.edad <= 99
        && d.posicion in ['comodin', 'arquero', 'defensor', 'medio', 'delantero']
        && d.foto is string && d.foto.size() < 200000
        && (d.foto == '' || d.foto.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'));
    }
    function nota(s, k) { return s[k] is int && s[k] >= 1 && s[k] <= 10; }
    function statsValidas(s) {
      return s.keys().hasOnly(['velocidad', 'tecnica', 'pase', 'remate', 'defensa', 'fisico', 'arquero'])
        && nota(s, 'velocidad') && nota(s, 'tecnica') && nota(s, 'pase') && nota(s, 'remate')
        && nota(s, 'defensa') && nota(s, 'fisico') && nota(s, 'arquero');
    }

    // Datos privados de cada usuario (su ficha y la lista de sus grupos).
    match /usuarios/{u} {
      allow read: if logueado() && uid() == u;
      allow create, update: if logueado() && uid() == u
        && request.resource.data.keys().hasOnly(['usuario', 'edad', 'posicion', 'foto', 'grupos', 'creado'])
        && perfilValido(request.resource.data)
        && request.resource.data.grupos is list && request.resource.data.grupos.size() <= 20;
    }

    match /grupos/{g} {
      // Solo los miembros ven el grupo. Afuera no se ve nada.
      allow read: if esMiembro(g);
      allow create: if logueado()
        && request.resource.data.creador == uid()
        && request.resource.data.admins == [uid()];
      // Los admins cambian todo; los armadores, los equipos y los pedidos de cambio;
      // los demás solo se anotan o se bajan a sí mismos y piden cambiarse de equipo.
      allow update: if esAdmin(g)
        || (esArmador(g) && cambia().hasOnly(['equipos', 'solicitudes']))
        || (
          esMiembro(g)
          && cambia().hasOnly(['anotados', 'solicitudes'])
          && request.resource.data.anotados.removeAll([uid()]) == resource.data.anotados.removeAll([uid()])
          && soloMiSolicitud()
        );
      allow delete: if esAdmin(g);

      // Para entrar hay que tener el código del link de invitación y no estar expulsado.
      match /miembros/{m} {
        allow read: if esMiembro(g);
        allow create: if logueado() && uid() == m
          && request.resource.data.keys().hasOnly(['usuario', 'edad', 'posicion', 'foto', 'codigo', 'unido'])
          && perfilValido(request.resource.data)
          && request.resource.data.codigo == grupo(g).codigo
          && !(m in grupo(g).get('baneados', []));
        allow update: if logueado() && uid() == m
          && request.resource.data.keys().hasOnly(['usuario', 'edad', 'posicion', 'foto', 'codigo', 'unido'])
          && perfilValido(request.resource.data)
          && request.resource.data.codigo == resource.data.codigo;
        allow delete: if logueado() && (uid() == m || esAdmin(g));
      }

      // Un voto por persona y por compañero: el id del documento es "quienVota_aQuien".
      // Se puede calificar a miembros y a invitados (gente sin cuenta que anotó el admin).
      match /votos/{v} {
        allow read: if esMiembro(g);
        allow create, update: if esMiembro(g)
          && request.resource.data.keys().hasOnly(['voter', 'target', 'stats', 'ts'])
          && request.resource.data.voter == uid()
          && request.resource.data.target is string
          && request.resource.data.target != uid()
          && v == uid() + '_' + request.resource.data.target
          && (exists(/databases/$(database)/documents/grupos/$(g)/miembros/$(request.resource.data.target))
            || (request.resource.data.target.matches('inv_.+')
              && grupo(g).get('invitados', {}).keys().hasAny([request.resource.data.target])))
          && statsValidas(request.resource.data.stats);
        allow delete: if logueado() && (resource.data.voter == uid() || esAdmin(g));
      }

      // Jugador del partido: una votación por fecha ("AAAA-MM-DD"). Se vota el día
      // siguiente al partido, de 00:00 a 23:59 hora argentina (UTC-3).
      match /mvp/{fecha} {
        function mvp() { return get(/databases/$(database)/documents/grupos/$(g)/mvp/$(fecha)).data; }
        function abreDe(f) {
          let p = f.split('-');
          return (timestamp.date(int(p[0]), int(p[1]), int(p[2])) + duration.value(27, 'h')).toMillis();
        }
        allow read: if esMiembro(g);
        // La crea cualquier miembro (con los anotados del partido) o un admin.
        // "anotados" guarda quiénes se anotaron esa fecha (para que venzan las 🟥).
        allow create: if esMiembro(g)
          && fecha.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['fecha', 'candidatos', 'nombres', 'abre', 'cierra', 'creado', 'anotados'])
          && request.resource.data.get('anotados', []) is list && request.resource.data.get('anotados', []).size() <= 60
          && request.resource.data.fecha == fecha
          && request.resource.data.abre == abreDe(fecha)
          && request.resource.data.cierra == request.resource.data.abre + 86400000
          && request.resource.data.candidatos is list
          && request.resource.data.candidatos.size() > 0 && request.resource.data.candidatos.size() <= 30
          && (esAdmin(g) || (
            grupo(g).partido.get('fecha', '') == fecha
            && grupo(g).anotados.hasAll(request.resource.data.candidatos)
            && request.resource.data.get('anotados', grupo(g).anotados) == grupo(g).anotados
          ));
        // Solo un admin cambia los candidatos (alguien que se sumó de imprevisto).
        allow update: if esAdmin(g)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['candidatos', 'nombres', 'anotados'])
          && request.resource.data.candidatos.size() > 0 && request.resource.data.candidatos.size() <= 30;
        allow delete: if esAdmin(g);

        // Un voto por persona (el id es el de quien vota), nunca a sí mismo, solo
        // mientras está abierta. Los votos ajenos se ven recién cuando cierra.
        match /votos/{v} {
          allow get: if esMiembro(g) && (v == uid() || request.time.toMillis() >= mvp().cierra);
          allow list: if esMiembro(g) && request.time.toMillis() >= mvp().cierra;
          allow create, update: if esMiembro(g) && v == uid()
            && request.resource.data.keys().hasOnly(['voto', 'ts'])
            && request.resource.data.voto != uid()
            && request.resource.data.voto in mvp().candidatos
            && request.time.toMillis() >= mvp().abre
            && request.time.toMillis() < mvp().cierra;
          allow delete: if esAdmin(g);
        }
      }

      // 🟥 Faltó sin avisar: lo reporta alguien que jugó esa fecha, a otro que estaba en
      // la lista, desde el día siguiente y durante una semana. El id es "fecha_aQuien_quienReporta".
      // Quién reportó lo ven solo los admins (y cada uno sus propios reportes).
      match /reportes/{r} {
        function mvpDe(f) { return get(/databases/$(database)/documents/grupos/$(g)/mvp/$(f)).data; }
        allow read: if esAdmin(g) || (logueado() && resource.data.por == uid());
        allow create: if esMiembro(g)
          && request.resource.data.keys().hasOnly(['fecha', 'target', 'por', 'ts'])
          && request.resource.data.por == uid()
          && request.resource.data.target is string
          && request.resource.data.target != uid()
          && request.resource.data.fecha is string
          && request.resource.data.fecha.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && r == request.resource.data.fecha + '_' + request.resource.data.target + '_' + uid()
          && uid() in mvpDe(request.resource.data.fecha).candidatos
          && request.resource.data.target in mvpDe(request.resource.data.fecha).candidatos
          && request.time.toMillis() >= mvpDe(request.resource.data.fecha).abre
          && request.time.toMillis() < mvpDe(request.resource.data.fecha).abre + 7 * 86400000;
        allow delete: if esAdmin(g) || (logueado() && resource.data.por == uid());
      }

      // Faltas aprobadas: las ve todo el grupo, las pone o las saca solo un admin.
      match /faltas/{f} {
        allow read: if esMiembro(g);
        allow create, update: if esAdmin(g)
          && request.resource.data.keys().hasOnly(['fecha', 'target', 'nombre', 'por', 'ts'])
          && f == request.resource.data.fecha + '_' + request.resource.data.target;
        allow delete: if esAdmin(g);
      }

      // Niveles que pone el admin: los ven admins y armadores (para equilibrar), los cambian solo los admins.
      match /privado/{doc} {
        allow read: if esAdmin(g) || esArmador(g);
        allow write: if esAdmin(g);
      }
    }
  }
}
