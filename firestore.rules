rules_version = '2';

// Reglas de seguridad de Firestore. Pegarlas en la consola de Firebase:
// Firestore Database → Reglas → Publicar.
// El dominio "fulbo.app" tiene que coincidir con CONFIG.dominio de index.html.
service cloud.firestore {
  match /databases/{database}/documents {
    function logueado() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function grupo(g) { return get(/databases/$(database)/documents/grupos/$(g)).data; }
    function esMiembro(g) {
      return logueado() && exists(/databases/$(database)/documents/grupos/$(g)/miembros/$(uid()));
    }
    function esAdmin(g) { return logueado() && uid() in grupo(g).admins; }
    // Armadores: designados por un admin para armar y editar equipos.
    function esArmador(g) { return logueado() && uid() in grupo(g).get('armadores', []); }
    function cambia() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Solo toca su propio pedido de cambio de equipo.
    function soloMiSolicitud() {
      let nuevas = request.resource.data.get('solicitudes', {});
      return nuevas.diff(resource.data.get('solicitudes', {})).affectedKeys().hasOnly([uid()])
        && (!(uid() in nuevas) || (nuevas[uid()].keys().hasOnly(['a', 'ts']) && nuevas[uid()].a in ['A', 'B']));
    }
    // Posición en la cancha: cada uno toca solo su propio lugar (equipos.pos), y tiene que
    // ser un lugar de su equipo ("A3", "B0"…). Que no esté ocupado lo controla la página.
    function soloMiPosicion() {
      let antes = resource.data.equipos;
      let despues = request.resource.data.equipos;
      let pos = despues.get('pos', {});
      return despues.diff(antes).affectedKeys().hasOnly(['pos'])
        && pos.diff(antes.get('pos', {})).affectedKeys().hasOnly([uid()])
        && (!(uid() in pos)
          || (uid() in despues.A && pos[uid()] is string && pos[uid()].matches('A[0-9]{1,2}'))
          || (uid() in despues.B && pos[uid()] is string && pos[uid()].matches('B[0-9]{1,2}')));
    }
    // Pedido para rehacer los equipos: el contador sube o baja de a uno y solo si en
    // la misma escritura aparece (o desaparece) el pedido propio de esta ronda.
    function miPedido(g) { return /databases/$(database)/documents/grupos/$(g)/rehacer/$(uid()); }
    function cuentaMiPedido(g) {
      let antes = resource.data.rehacer;
      let despues = request.resource.data.rehacer;
      let tenia = exists(miPedido(g)) && get(miPedido(g)).data.ronda == antes.ronda;
      let tiene = existsAfter(miPedido(g)) && getAfter(miPedido(g)).data.ronda == antes.ronda;
      return despues.keys().hasOnly(['ronda', 'n'])
        && despues.ronda == antes.ronda
        && antes.ronda == resource.data.equipos.ronda
        && ((despues.n == antes.n + 1 && !tenia && tiene) || (despues.n == antes.n - 1 && tenia && !tiene));
    }

    // Ficha de un jugador: el nombre tiene que ser el de su propia cuenta.
    function perfilValido(d) {
      return d.usuario is string
        && d.usuario.lower() + '@fulbo.app' == request.auth.token.email
        && d.edad is int && d.edad >= 10 && d.edad <= 99
        && d.posicion in ['comodin', 'arquero', 'defensor', 'medio', 'delantero']
        && d.foto is string && d.foto.size() < 200000
        && (d.foto == '' || d.foto.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'))
        && d.get('lesionado', false) is bool
        && d.get('cuadro', '') is string && d.get('cuadro', '').size() <= 24;
    }
    function nota(s, k) { return s[k] is int && s[k] >= 1 && s[k] <= 10; }

    // Datos privados de cada usuario (su ficha y la lista de sus grupos).
    match /usuarios/{u} {
      allow read: if logueado() && uid() == u;
      allow create, update: if logueado() && uid() == u
        && request.resource.data.keys().hasOnly(['usuario', 'edad', 'posicion', 'foto', 'lesionado', 'cuadro', 'grupos', 'creado', 'pendientes'])
        && perfilValido(request.resource.data)
        && request.resource.data.grupos is list && request.resource.data.grupos.size() <= 20
        && request.resource.data.get('pendientes', []) is list && request.resource.data.get('pendientes', []).size() <= 20;
    }

    // Mail de recuperación: lo ve solo su dueño y lo escribe solo el servidor (api/cuenta.js).
    // Los códigos de los links de los mails (tokens/...) no los lee nadie desde la página.
    match /privado/{u} {
      allow read: if logueado() && uid() == u;
    }

    // Amistosos: un partido compartido entre dos grupos (no es un grupo). El id es largo y al azar y hace
    // de invitación: lo ve quien tenga el link, pero no se pueden listar. Lo arma un admin del grupo local;
    // un admin del grupo rival lo suma a su grupo y queda como admin del amistoso. Nadie entra al grupo del otro.
    function amistoso(a) { return get(/databases/$(database)/documents/amistosos/$(a)).data; }
    function textoCorto(x, n) { return x is string && x.size() <= n; }
    function datosAmistoso(d) {
      return d.keys().hasOnly(['local', 'rival', 'creador', 'admins', 'fecha', 'hora', 'lugar', 'cupo', 'suspendido', 'resultado', 'ts', 'estado'])
        && d.get('estado', 'aceptado') in ['pendiente', 'aceptado', 'rechazado']
        && d.local.keys().hasOnly(['gid', 'nombre']) && d.local.gid is string && textoCorto(d.local.nombre, 60)
        && d.rival.keys().hasOnly(['gid', 'nombre']) && (d.rival.gid == null || d.rival.gid is string) && textoCorto(d.rival.nombre, 60)
        && d.admins is list && d.admins.size() <= 12
        && textoCorto(d.fecha, 10) && textoCorto(d.hora, 5) && textoCorto(d.lugar, 60)
        && d.cupo is int && d.cupo >= 3 && d.cupo <= 11
        && d.suspendido is bool
        && (d.resultado == null || (d.resultado.keys().hasOnly(['ga', 'gb'])
          && d.resultado.ga is int && d.resultado.ga >= 0 && d.resultado.ga <= 99
          && d.resultado.gb is int && d.resultado.gb >= 0 && d.resultado.gb <= 99));
    }
    match /amistosos/{a} {
      allow get: if logueado();
      allow create: if logueado()
        && datosAmistoso(request.resource.data)
        && request.resource.data.creador == uid()
        && uid() in request.resource.data.admins
        && esAdmin(request.resource.data.local.gid);
      // Los admins cambian fecha, cancha, cupo, suspendido y resultado. Un admin del grupo rival lo acepta (o lo suma
      // a su grupo, si vino por link) y queda como admin del amistoso; o lo rechaza.
      allow update: if logueado() && datosAmistoso(request.resource.data) && (
          (uid() in resource.data.admins
            && request.resource.data.local == resource.data.local
            && request.resource.data.rival == resource.data.rival
            && request.resource.data.creador == resource.data.creador
            && request.resource.data.admins == resource.data.admins)
          || (esAdmin(resource.data.rival.gid) && !(uid() in resource.data.admins)
            && cambia().hasOnly(['estado']) && request.resource.data.estado == 'rechazado')
          || (cambia().hasOnly(['rival', 'admins', 'estado'])
            && request.resource.data.get('estado', 'aceptado') == 'aceptado'
            && request.resource.data.rival.nombre == resource.data.rival.nombre
            && (resource.data.rival.gid == null || resource.data.rival.gid == request.resource.data.rival.gid)
            && request.resource.data.rival.gid is string
            && request.resource.data.rival.gid != resource.data.local.gid
            && esAdmin(request.resource.data.rival.gid)
            && !(uid() in resource.data.admins)
            && request.resource.data.admins == resource.data.admins.concat([uid()])));
      allow delete: if logueado() && esAdmin(resource.data.local.gid);

      // Los anotados de cada lado (A = el grupo local, B = el rival). Cada uno se anota solo del lado de su
      // grupo; si el rival no tiene grupo en Fulbo, cualquiera con el link se anota del lado B.
      // Los admins anotan a gente sin cuenta (inv_...) y sacan a cualquiera.
      match /anotados/{u} {
        allow read: if logueado();
        allow create: if logueado()
          && request.resource.data.lado in ['A', 'B']
          && request.resource.data.ts is int
          && (
            (u == uid()
              && request.resource.data.keys().hasOnly(['lado', 'usuario', 'foto', 'posicion', 'ts'])
              && request.resource.data.usuario.lower() + '@fulbo.app' == request.auth.token.email
              && request.resource.data.foto is string && request.resource.data.foto.size() < 200000
              && request.resource.data.posicion in ['comodin', 'arquero', 'defensor', 'medio', 'delantero']
              && ((request.resource.data.lado == 'A' && esMiembro(amistoso(a).local.gid))
                || (request.resource.data.lado == 'B' && (amistoso(a).rival.gid == null || esMiembro(amistoso(a).rival.gid)))))
            || (u.matches('inv_[A-Za-z0-9]+')
              && uid() in amistoso(a).admins
              && request.resource.data.keys().hasOnly(['lado', 'usuario', 'inv', 'por', 'ts'])
              && textoCorto(request.resource.data.usuario, 30) && request.resource.data.usuario.size() > 0
              && request.resource.data.inv == true && request.resource.data.por == uid()));
        allow delete: if logueado() && (u == uid() || uid() in amistoso(a).admins);
      }
    }

    // Torneos entre grupos: como los amistosos, se comparte el torneo y no los grupos. Lo arma un admin de un grupo
    // (los admins de ese grupo lo organizan) e invita a otros grupos; el admin de cada grupo invitado acepta (su grupo
    // pasa a ser un equipo y él, su capitán) o dice que no. Se lee con el id, no se puede listar.
    function torneoG(a) { return get(/databases/$(database)/documents/torneos/$(a)).data; }
    function datosTorneoG(d) {
      return d.keys().hasOnly(['nombre', 'creado', 'creador', 'org', 'admins', 'invitados', 'nombresInv', 'rechazados', 'gids', 'equipos',
          'estado', 'formato', 'vueltas', 'cant', 'cuando', 'arbitro', 'arbitroNombre', 'partidos', 'llave', 'res', 'modo', 'empezo', 'termino'])
        && textoCorto(d.nombre, 40) && d.creado is int
        && d.org.keys().hasOnly(['gid', 'nombre']) && d.org.gid is string && textoCorto(d.org.nombre, 60)
        && d.admins is list && d.admins.size() <= 12
        && d.invitados is list && d.invitados.size() <= 16 && d.nombresInv is map
        && d.get('rechazados', []) is list && d.get('rechazados', []).size() <= 40
        && d.gids is list && d.gids.size() <= 16 && d.equipos is list && d.equipos.size() == d.gids.size()
        && d.org.gid in d.gids
        && d.estado in ['armando', 'jugando', 'terminado']
        && d.partidos is list && d.partidos.size() <= 300;
    }
    function aceptaTorneo() {
      let g = request.resource.data.gids[request.resource.data.gids.size() - 1];
      let e = request.resource.data.equipos[request.resource.data.equipos.size() - 1];
      return resource.data.estado == 'armando'
        && cambia().hasOnly(['invitados', 'gids', 'equipos'])
        && g in resource.data.invitados && esAdmin(g)
        && request.resource.data.invitados == resource.data.invitados.removeAll([g])
        && request.resource.data.gids == resource.data.gids.concat([g])
        && request.resource.data.equipos == resource.data.equipos.concat([e])
        && e.keys().hasOnly(['gid', 'nombre', 'colores', 'diseno', 'capitan'])
        && e.gid == g && e.capitan == uid() && textoCorto(e.nombre, 20);
    }
    function rechazaTorneo() {
      let lista = request.resource.data.get('rechazados', []);
      let g = lista[lista.size() - 1];
      return cambia().hasOnly(['invitados', 'rechazados'])
        && g in resource.data.invitados && esAdmin(g)
        && request.resource.data.invitados == resource.data.invitados.removeAll([g])
        && lista == resource.data.get('rechazados', []).concat([g]);
    }
    match /torneos/{a} {
      allow get: if logueado();
      allow create: if logueado() && datosTorneoG(request.resource.data)
        && request.resource.data.creador == uid() && uid() in request.resource.data.admins
        && esAdmin(request.resource.data.org.gid)
        && request.resource.data.gids == [request.resource.data.org.gid]
        && request.resource.data.invitados.size() == 0
        && request.resource.data.estado == 'armando';
      // Los que organizan cambian todo menos quiénes organizan; de los grupos que aceptaron solo pueden sacar.
      allow update: if logueado() && datosTorneoG(request.resource.data) && (
          (uid() in resource.data.admins
            && request.resource.data.admins == resource.data.admins
            && request.resource.data.org == resource.data.org
            && request.resource.data.creador == resource.data.creador
            && request.resource.data.creado == resource.data.creado
            && resource.data.gids.hasAll(request.resource.data.gids))
          || aceptaTorneo()
          || rechazaTorneo());
      allow delete: if logueado() && uid() in resource.data.admins;

      // Jugadores de cada equipo: cada uno se anota con el equipo de su grupo. Los que organizan y el admin
      // de cada grupo anotan a gente sin cuenta (inv_...) y sacan a cualquiera de su equipo.
      match /jugadores/{u} {
        allow read: if logueado();
        allow create: if logueado()
          && request.resource.data.e in torneoG(a).gids
          && request.resource.data.ts is int
          && (
            (u == uid()
              && request.resource.data.keys().hasOnly(['e', 'usuario', 'foto', 'posicion', 'ts'])
              && esMiembro(request.resource.data.e)
              && request.resource.data.usuario.lower() + '@fulbo.app' == request.auth.token.email
              && request.resource.data.foto is string && request.resource.data.foto.size() < 200000
              && request.resource.data.posicion in ['comodin', 'arquero', 'defensor', 'medio', 'delantero'])
            || (u.matches('inv_[A-Za-z0-9]+')
              && (uid() in torneoG(a).admins || esAdmin(request.resource.data.e))
              && request.resource.data.keys().hasOnly(['e', 'usuario', 'inv', 'por', 'ts'])
              && textoCorto(request.resource.data.usuario, 30) && request.resource.data.usuario.size() > 0
              && request.resource.data.inv == true && request.resource.data.por == uid()));
        allow delete: if logueado() && (u == uid() || uid() in torneoG(a).admins || esAdmin(resource.data.e));
      }

      // Resultados (como en el torneo interno): los cargan los que organizan, los capitanes de los dos equipos o el árbitro.
      match /resultados/{k} {
        allow read: if logueado();
        allow create, update: if logueado()
          && (uid() in torneoG(a).admins
            || torneoG(a).equipos[request.resource.data.a].get('capitan', '') == uid()
            || torneoG(a).equipos[request.resource.data.b].get('capitan', '') == uid()
            || torneoG(a).get('arbitro', '') == uid())
          && torneoG(a).estado == 'jugando'
          && request.resource.data.keys().hasOnly(['torneo', 'a', 'b', 'ga', 'gb', 'gana', 'por', 'ts', 'eventos', 'vivo'])
          && request.resource.data.torneo == torneoG(a).creado
          && request.resource.data.por == uid()
          && request.resource.data.a is int && request.resource.data.b is int
          && (!k.matches('^[0-9]+$') || (torneoG(a).partidos[int(k)].a == request.resource.data.a
            && torneoG(a).partidos[int(k)].b == request.resource.data.b))
          && (request.resource.data.ga == null || (request.resource.data.ga is int && request.resource.data.ga >= 0 && request.resource.data.ga <= 99))
          && (request.resource.data.gb == null || (request.resource.data.gb is int && request.resource.data.gb >= 0 && request.resource.data.gb <= 99))
          && request.resource.data.gana in [null, 'a', 'b']
          && (!('eventos' in request.resource.data) || (request.resource.data.eventos is list && request.resource.data.eventos.size() <= 150))
          && request.resource.data.get('vivo', false) is bool;
        allow delete: if logueado() && uid() in torneoG(a).admins;
      }
    }

    // Código de cada grupo para desafiarlo a un amistoso (UADE4821 → el grupo). Se busca por el código exacto:
    // no se pueden listar. Lo crea y lo cambia un admin de ese grupo.
    match /codigos/{c} {
      allow get: if logueado();
      allow create: if logueado() && esAdmin(request.resource.data.gid)
        && request.resource.data.keys().hasOnly(['gid', 'nombre'])
        && textoCorto(request.resource.data.nombre, 60)
        && c.matches('[A-Z0-9]{6,10}');
      allow update: if logueado() && esAdmin(resource.data.gid)
        && request.resource.data.gid == resource.data.gid
        && request.resource.data.keys().hasOnly(['gid', 'nombre'])
        && textoCorto(request.resource.data.nombre, 60);
      allow delete: if logueado() && esAdmin(resource.data.gid);
    }

    match /grupos/{g} {
      // Solo los miembros ven el grupo. Afuera no se ve nada.
      allow read: if esMiembro(g);
      allow create: if logueado()
        && request.resource.data.creador == uid()
        && request.resource.data.admins == [uid()];
      // Los admins cambian todo; los armadores, los equipos y los pedidos de cambio;
      // los demás solo se anotan o se bajan a sí mismos (como jugadores o como público),
      // piden cambiarse de equipo, piden rehacer los equipos o eligen su lugar en la cancha.
      allow update: if esAdmin(g)
        || (esArmador(g) && cambia().hasOnly(['equipos', 'solicitudes', 'rehacer']))
        || (
          esMiembro(g)
          && cambia().hasOnly(['anotados', 'solicitudes', 'publico'])
          && request.resource.data.anotados.removeAll([uid()]) == resource.data.anotados.removeAll([uid()])
          && request.resource.data.get('publico', []) is list && request.resource.data.get('publico', []).size() <= 60
          && request.resource.data.get('publico', []).removeAll([uid()]) == resource.data.get('publico', []).removeAll([uid()])
          && soloMiSolicitud()
        )
        || (esMiembro(g) && cambia().hasOnly(['rehacer']) && cuentaMiPedido(g))
        || (esMiembro(g) && cambia().hasOnly(['equipos']) && soloMiPosicion());
      allow delete: if esAdmin(g);

      // Al grupo se entra con el link por api/grupo.js (que pide la aprobación de un admin);
      // desde la página solo se agrega el que creó el grupo.
      // "lesionado" lo pone solo el propio jugador (ningún admin puede tocar esta ficha).
      match /miembros/{m} {
        allow read: if esMiembro(g);
        allow create: if logueado() && uid() == m
          && request.resource.data.keys().hasOnly(['usuario', 'edad', 'posicion', 'foto', 'lesionado', 'cuadro', 'codigo', 'unido'])
          && perfilValido(request.resource.data)
          && request.resource.data.codigo == grupo(g).codigo
          && grupo(g).creador == uid();
        allow update: if logueado() && uid() == m
          && request.resource.data.keys().hasOnly(['usuario', 'edad', 'posicion', 'foto', 'lesionado', 'cuadro', 'codigo', 'unido'])
          && perfilValido(request.resource.data)
          && request.resource.data.codigo == resource.data.codigo;
        allow delete: if logueado() && (uid() == m || esAdmin(g));
      }

      // Un voto por persona y por compañero: el id del documento es "quienVota_aQuien".
      // Se puede calificar a miembros y a invitados (gente sin cuenta que anotó el admin).
      // Votos: cada uno lee solo los suyos (así nadie sabe qué le puso otro). Los guarda
      // api/grupo.js, que arma los promedios en calc/notas.
      match /votos/{v} {
        allow read: if logueado() && resource.data.voter == uid();
      }
      match /calc/{c} {
        allow read: if esMiembro(g);
      }
      // Pedidos para entrar: los ven los admins y el que pidió (que lo puede cancelar).
      match /pendientes/{u} {
        allow read: if esAdmin(g) || (logueado() && uid() == u);
        allow delete: if logueado() && uid() == u;
      }

      // Jugador del partido: una votación por fecha ("AAAA-MM-DD"). Abre una hora
      // después de que empieza el partido (si no tiene hora "HH:MM", a las 00:00 del
      // día siguiente) y cierra el día siguiente a las 15:00. Hora argentina (UTC-3).
      match /mvp/{fecha} {
        function mvp() { return get(/databases/$(database)/documents/grupos/$(g)/mvp/$(fecha)).data; }
        function inicioDe(f) {
          let p = f.split('-');
          return (timestamp.date(int(p[0]), int(p[1]), int(p[2])) + duration.value(3, 'h')).toMillis();
        }
        function abreDe(f, hora) {
          return hora.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
            ? inicioDe(f) + (int(hora.split(':')[0]) * 60 + int(hora.split(':')[1]) + 60) * 60000
            : inicioDe(f) + 86400000;
        }
        allow read: if esMiembro(g);
        // La crea cualquier miembro (con los anotados y la hora del partido) o un admin.
        // "anotados" guarda quiénes se anotaron esa fecha (para que venzan las 🟥).
        allow create: if esMiembro(g)
          && fecha.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['fecha', 'candidatos', 'nombres', 'abre', 'cierra', 'creado', 'anotados'])
          && request.resource.data.get('anotados', []) is list && request.resource.data.get('anotados', []).size() <= 60
          && request.resource.data.fecha == fecha
          && request.resource.data.abre is int
          && request.resource.data.abre >= inicioDe(fecha) + 3600000
          && request.resource.data.abre <= inicioDe(fecha) + 86400000
          // A las 15:00 del día siguiente (antes era a las 00:00 del otro día).
          && request.resource.data.cierra in [inicioDe(fecha) + 86400000 + 15 * 3600000, inicioDe(fecha) + 2 * 86400000]
          && request.resource.data.candidatos is list
          && request.resource.data.candidatos.size() > 0 && request.resource.data.candidatos.size() <= 30
          && (esAdmin(g) || (
            // Con la hora como 20:00 tiene que coincidir; si está escrita suelta ("Viernes 20hs"),
            // alcanza con que esté entre 1 y 24 h después (lo de arriba).
            (!grupo(g).partido.get('cuando', '').matches('([01][0-9]|2[0-3]):[0-5][0-9]')
              || request.resource.data.abre == abreDe(fecha, grupo(g).partido.get('cuando', '')))
            && grupo(g).partido.get('fecha', '') == fecha
            && grupo(g).anotados.hasAll(request.resource.data.candidatos)
            && request.resource.data.get('anotados', grupo(g).anotados) == grupo(g).anotados
          ));
        // Solo un admin cambia los candidatos (alguien que se sumó de imprevisto).
        allow update: if esAdmin(g)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['candidatos', 'nombres', 'anotados'])
          && request.resource.data.candidatos.size() > 0 && request.resource.data.candidatos.size() <= 30;
        allow delete: if esAdmin(g);

        // Un voto por persona (el id es el de quien vota), nunca a sí mismo, solo
        // mientras está abierta. Los votos ajenos se ven recién cuando cierra.
        match /votos/{v} {
          allow get: if esMiembro(g) && (v == uid() || request.time.toMillis() >= mvp().cierra);
          allow list: if esMiembro(g) && request.time.toMillis() >= mvp().cierra;
          allow create, update: if esMiembro(g) && v == uid()
            && request.resource.data.keys().hasOnly(['voto', 'ts'])
            && request.resource.data.voto != uid()
            && request.resource.data.voto in mvp().candidatos
            && request.time.toMillis() >= mvp().abre
            && request.time.toMillis() < mvp().cierra;
          allow delete: if esAdmin(g);
        }
      }

      // 🟥 Faltó sin avisar: lo reporta alguien que jugó esa fecha, a otro que estaba en
      // la lista, desde el día siguiente y durante una semana. El id es "fecha_aQuien_quienReporta".
      // Quién reportó lo ven solo los admins (y cada uno sus propios reportes).
      match /reportes/{r} {
        function mvpDe(f) { return get(/databases/$(database)/documents/grupos/$(g)/mvp/$(f)).data; }
        allow read: if esAdmin(g) || (logueado() && resource.data.por == uid());
        allow create: if esMiembro(g)
          && request.resource.data.keys().hasOnly(['fecha', 'target', 'por', 'ts'])
          && request.resource.data.por == uid()
          && request.resource.data.target is string
          && request.resource.data.target != uid()
          && request.resource.data.fecha is string
          && request.resource.data.fecha.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && r == request.resource.data.fecha + '_' + request.resource.data.target + '_' + uid()
          && uid() in mvpDe(request.resource.data.fecha).candidatos
          && request.resource.data.target in mvpDe(request.resource.data.fecha).candidatos
          && request.time.toMillis() >= mvpDe(request.resource.data.fecha).abre
          && request.time.toMillis() < mvpDe(request.resource.data.fecha).abre + 7 * 86400000;
        allow delete: if esAdmin(g) || (logueado() && resource.data.por == uid());
      }

      // Pedidos para rehacer los equipos (el id es el de quien pide). Cada uno ve el
      // suyo; la lista completa, solo los admins. Se crea o se borra junto con el
      // contador del grupo, que es lo que ven todos.
      match /rehacer/{u} {
        function rehacerDespues() { return getAfter(/databases/$(database)/documents/grupos/$(g)).data.rehacer; }
        allow get: if logueado() && (uid() == u || esAdmin(g));
        allow list: if esAdmin(g);
        allow create, update: if esMiembro(g) && uid() == u
          && uid() in grupo(g).anotados
          && request.resource.data.keys().hasOnly(['ronda', 'ts'])
          && request.resource.data.ronda == rehacerDespues().ronda
          && rehacerDespues().n == grupo(g).rehacer.n + 1;
        allow delete: if logueado() && uid() == u
          && (grupo(g).get('rehacer', null) == null
            || resource.data.ronda != grupo(g).rehacer.ronda
            || rehacerDespues().n == grupo(g).rehacer.n - 1);
      }

      // A qué celulares mandarle notificaciones (los manda api/avisar.js). Cada uno
      // ve y cambia solo los suyos; nadie más los lee desde la app.
      match /push/{u} {
        allow read, delete: if logueado() && uid() == u;
        allow create, update: if esMiembro(g) && uid() == u
          && request.resource.data.keys().hasOnly(['tokens', 'ts'])
          && request.resource.data.tokens is list && request.resource.data.tokens.size() <= 5;
      }

      // Bajas tardías (asistencia): las registra solo el servidor (api/avisar.js).
      // Las ve todo el grupo y un admin las puede perdonar (borrar).
      // Resultado de cada fecha: lo cargan los admins y armadores, lo ven todos.
      match /resultados/{f} {
        allow read: if esMiembro(g);
        allow create, update: if (esAdmin(g) || esArmador(g))
          && request.resource.data.keys().hasOnly(['fecha', 'ganador', 'golesA', 'golesB', 'A', 'B', 'SA', 'SB', 'nombres', 'goles', 'por', 'ts'])
          && request.resource.data.fecha == f
          && request.resource.data.ganador in ['A', 'B', 'empate']
          && request.resource.data.por == uid()
          && request.resource.data.A is list && request.resource.data.A.size() <= 30
          && request.resource.data.B is list && request.resource.data.B.size() <= 30
          && (!('SA' in request.resource.data) || (request.resource.data.SA is list && request.resource.data.SA.size() <= 30))
          && (!('SB' in request.resource.data) || (request.resource.data.SB is list && request.resource.data.SB.size() <= 30))
          && (!('nombres' in request.resource.data) || (request.resource.data.nombres is map && request.resource.data.nombres.size() <= 120))
          // Goles de cada uno (lo carga el admin o un armador): { uid: cantidad }.
          && (!('goles' in request.resource.data) || (request.resource.data.goles is map && request.resource.data.goles.size() <= 60))
          && (!('golesA' in request.resource.data) || (request.resource.data.golesA is int && request.resource.data.golesA >= 0 && request.resource.data.golesA <= 99
            && request.resource.data.golesB is int && request.resource.data.golesB >= 0 && request.resource.data.golesB <= 99));
        allow delete: if esAdmin(g);
      }
      match /bajas/{b} {
        allow read: if esMiembro(g);
        allow delete: if esAdmin(g);
      }

      // Faltas aprobadas: las ve todo el grupo, las pone o las saca solo un admin.
      match /faltas/{f} {
        allow read: if esMiembro(g);
        allow create, update: if esAdmin(g)
          && request.resource.data.keys().hasOnly(['fecha', 'target', 'nombre', 'por', 'ts'])
          && f == request.resource.data.fecha + '_' + request.resource.data.target;
        allow delete: if esAdmin(g);
      }

      // Nombre, colores y diseño de cada equipo del torneo interno: los elige su capitán o un admin.
      // El documento se llama como el número del equipo y vale solo para el torneo actual (torneo = creado).
      match /torneoEquipos/{i} {
        allow read: if esMiembro(g);
        allow create, update: if (esAdmin(g) || grupo(g).torneo.equipos[int(i)].get('capitan', '') == uid())
          && request.resource.data.keys().hasOnly(['torneo', 'nombre', 'colores', 'diseno', 'por', 'ts'])
          && request.resource.data.torneo == grupo(g).torneo.creado
          && request.resource.data.por == uid()
          && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 20
          && request.resource.data.colores is list && request.resource.data.colores.size() > 0 && request.resource.data.colores.size() <= 2
          && request.resource.data.diseno in ['lisa', 'mangas', 'bastones', 'franja', 'banda'];
        allow delete: if esAdmin(g);
      }

      // Resultados del torneo interno: los cargan los capitanes de los dos equipos, el árbitro del torneo o un admin.
      // El documento se llama como el partido (su número en la liga, 'ronda-lugar' en la copa) y vale solo para
      // el torneo actual. En la liga se controla que los equipos sean los de ese partido.
      match /torneoResultados/{k} {
        allow read: if esMiembro(g);
        allow create, update: if (esAdmin(g)
            || grupo(g).torneo.equipos[request.resource.data.a].get('capitan', '') == uid()
            || grupo(g).torneo.equipos[request.resource.data.b].get('capitan', '') == uid()
            || grupo(g).torneo.get('arbitro', '') == uid())
          && grupo(g).torneo.estado == 'jugando'
          && request.resource.data.keys().hasOnly(['torneo', 'a', 'b', 'ga', 'gb', 'gana', 'por', 'ts', 'eventos', 'vivo'])
          && (!('eventos' in request.resource.data) || (request.resource.data.eventos is list && request.resource.data.eventos.size() <= 150))
          && request.resource.data.get('vivo', false) is bool
          && request.resource.data.torneo == grupo(g).torneo.creado
          && request.resource.data.por == uid()
          && request.resource.data.a is int && request.resource.data.b is int
          && (!k.matches('^[0-9]+$') || (grupo(g).torneo.partidos[int(k)].a == request.resource.data.a
            && grupo(g).torneo.partidos[int(k)].b == request.resource.data.b))
          && (request.resource.data.ga == null || (request.resource.data.ga is int && request.resource.data.ga >= 0 && request.resource.data.ga <= 99))
          && (request.resource.data.gb == null || (request.resource.data.gb is int && request.resource.data.gb >= 0 && request.resource.data.gb <= 99))
          && request.resource.data.gana in [null, 'a', 'b'];
        allow delete: if esAdmin(g);
      }

      // Desafíos a un amistoso que le mandaron a este grupo (el id es el del amistoso). Los ven sus admins;
      // los manda un admin del grupo que desafía, para un amistoso suyo contra este grupo.
      match /desafios/{a} {
        allow read: if esAdmin(g);
        allow create: if logueado()
          && request.resource.data.keys().hasOnly(['desde', 'nombre', 'por', 'ts'])
          && esAdmin(request.resource.data.desde)
          && request.resource.data.por == uid()
          && textoCorto(request.resource.data.nombre, 60)
          && amistoso(a).local.gid == request.resource.data.desde
          && amistoso(a).rival.gid == g;
        allow delete: if esAdmin(g) || esAdmin(resource.data.desde);
      }

      // Invitaciones a torneos entre grupos que le llegaron a este grupo (el id es el del torneo). Las ven sus
      // admins; las manda uno de los que organizan, para un torneo que ya lo tiene invitado.
      match /torneosInv/{a} {
        allow read: if esAdmin(g);
        allow create: if logueado()
          && request.resource.data.keys().hasOnly(['desde', 'nombre', 'por', 'ts'])
          && esAdmin(request.resource.data.desde)
          && request.resource.data.por == uid()
          && textoCorto(request.resource.data.nombre, 60)
          && torneoG(a).org.gid == request.resource.data.desde
          && g in torneoG(a).invitados;
        allow delete: if esAdmin(g) || esAdmin(resource.data.desde);
      }

      // Niveles que pone el admin: los ven admins y armadores (para equilibrar), los cambian solo los admins.
      match /privado/{doc} {
        allow read: if esAdmin(g) || esArmador(g);
        allow write: if esAdmin(g);
      }
    }
  }
}
